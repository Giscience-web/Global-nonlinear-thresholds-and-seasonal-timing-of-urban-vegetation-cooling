def permute_naive_delta_rmse(model, Xtest, ytest, j, rmse_base, repeats=3, seed=0):
    rng = np.random.default_rng(seed)
    deltas = []

    for r in range(repeats):
        Xp = Xtest.copy()
        rng.shuffle(Xp[:, j])
        p = model.predict(Xp)
        rmse = mean_squared_error(ytest, p) ** 0.5
        deltas.append(rmse - rmse_base)

    return float(np.mean(deltas)), float(np.std(deltas))

def permute_conditional_delta_rmse(model, Xtest, ytest, j, rmse_base, alpha=1.0, repeats=3, seed=0):
    rng = np.random.default_rng(seed)

    others = [k for k in range(Xtest.shape[1]) if k != j]
    Xo = Xtest[:, others]
    xj = Xtest[:, j]

    resid, xhat = ridge_fit_residual(Xo, xj, alpha=alpha)

    deltas = []

    for r in range(repeats):
        Xp = Xtest.copy()
        rp = resid.copy()
        rng.shuffle(rp)
        Xp[:, j] = xhat + rp
        p = model.predict(Xp)
        rmse = mean_squared_error(ytest, p) ** 0.5
        deltas.append(rmse - rmse_base)

    return float(np.mean(deltas)), float(np.std(deltas))

