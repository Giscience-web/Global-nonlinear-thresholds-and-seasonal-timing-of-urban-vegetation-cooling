def gen_one_ts_for_clim(clim, rng, ar1_rho=AR1_RHO, noise_scale=NOISE_SCALE, clip=True):
    X = np.zeros((T, len(channels)), dtype=np.float32)

    for j, ch in enumerate(channels):
        if (clim in lib) and (ch in lib[clim]):
            mu  = lib[clim][ch]["mu"]
            sg  = lib[clim][ch]["sigma"]
            plo = lib[clim][ch]["plo"]
            phi = lib[clim][ch]["phi"]

            mult = NOISE_MULT.get(ch, DEFAULT_NOISE_MULT)
            sigma0 = float(np.nanmedian(sg)) * float(noise_scale) * float(mult)

            x = mu + ar1_noise(T, sigma=sigma0, rho=ar1_rho, rng=rng)

            if clip:
                x = np.minimum(np.maximum(x, plo), phi)

            X[:, j] = x.astype(np.float32)

        else:
            raise RuntimeError(f"Missing channel {ch} for climate group {clim}")

    return X

def predict_lst_series(X_ts):
    return model.predict(X_ts).astype(np.float32)

def build_X1_main(X0, d):
    X1 = X0.copy()

    for ch in SHIFT_VARS_MODEL:
        if ch in feat2idx:
            j = feat2idx[ch]
            X1[:, j] = greenup_advance(
                X1[:, j],
                advance_days=d,
                window_doy=GREENUP_DOY,
                dt_days=DT_DAYS,
                blend_steps=BLEND_STEPS
            ).astype(np.float32)

    return X1

def build_X1_placebo_randomwindow(X0, d, rng):
    X1 = X0.copy()

    placebo_win = random_window_same_length(
        rng,
        ref_window_doy=GREENUP_DOY,
        T=X0.shape[0],
        dt_days=DT_DAYS
    )

    for ch in SHIFT_VARS_MODEL:
        if ch in feat2idx:
            j = feat2idx[ch]
            X1[:, j] = greenup_advance(
                X1[:, j],
                advance_days=d,
                window_doy=placebo_win,
                dt_days=DT_DAYS,
                blend_steps=BLEND_STEPS
            ).astype(np.float32)

    return X1

