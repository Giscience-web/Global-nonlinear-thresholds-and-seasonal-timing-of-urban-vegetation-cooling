def clim_of_city(city):
    return city2clim.get(city, "UNK")

# ============================================================
# 2. File utilities
# ============================================================

def list_cities(root):
    if not os.path.exists(root):
        raise FileNotFoundError(f"ROOT not found: {root}")

    return sorted([
        d for d in os.listdir(root)
        if os.path.isdir(os.path.join(root, d))
    ])

def find_years_in_city(cdir):
    years = []

    if not os.path.exists(cdir):
        return years

    for fn in os.listdir(cdir):
        fnl = fn.lower()

        if fnl.endswith(".tif") and (
            "_evi_8day_0p1deg_" in fnl or
            "_lai_8day_0p1deg_" in fnl or
            "_lst_8day_0p1deg_" in fnl or
            "_lstd_8day_0p1deg_" in fnl or
            "_era5lmain_8day_0p1deg_" in fnl
        ):
            m = year_re.match(fn)
            if m:
                years.append(int(m.group(1)))

    return sorted(list(set(years)))

def pick_years(years, k):
    if len(years) <= k:
        return years

    idx = rng.choice(len(years), size=k, replace=False)
    return [years[i] for i in sorted(idx)]

def p_city_var_year(city, var, year):
    """
    var:
      EVI, LAI, LST, DEM, ERA5LMAIN, NTL, LC
    """
    if var == "LC":
        return os.path.join(
            ROOT,
            city,
            f"{city}_MODIS_LC_STACK_2013_2025_0p005deg.tif"
        )

    if var == "NTL":
        return os.path.join(
            ROOT,
            city,
            f"{city}_NTL_monthly_0p1deg_{year}.tif"
        )

    if var == "ERA5LMAIN":
        return os.path.join(
            ROOT,
            city,
            f"{city}_ERA5Lmain_8day_0p1deg_{year}.tif"
        )

    return os.path.join(
        ROOT,
        city,
        f"{city}_{var}_8day_0p1deg_{year}.tif"
    )

def out_hw(H, W, factor):
    return int(math.ceil(H / factor)), int(math.ceil(W / factor))

def monthly12_to_46(x12):
    x12 = np.asarray(x12, dtype=float)
    t12 = np.linspace(0, T8 - 1, num=12)
    t46 = np.arange(T8)
    return np.interp(t46, t12, x12)

def robust_summary(vecs_2d):
    """
    Old-style summary:
      mean, p10, p90
    """
    mean = np.nanmean(vecs_2d, axis=0)
    p10  = np.nanpercentile(vecs_2d, 10, axis=0)
    p90  = np.nanpercentile(vecs_2d, 90, axis=0)
    return mean, p10, p90

def read_allbands_coarse_median(path, factor=10, resampling=Resampling.average, band_ids=None):
    """
    Read raster bands, downsample spatially, then return per-band spatial median.
    """
    with rasterio.open(path) as ds:
        H, W = ds.height, ds.width
        oh, ow = out_hw(H, W, factor)

        if band_ids is None:
            band_ids = list(range(1, ds.count + 1))

        data = ds.read(
            indexes=band_ids,
            masked=True,
            out_shape=(len(band_ids), oh, ow),
            resampling=resampling
        ).astype(np.float32)

        if np.ma.isMaskedArray(data):
            data = data.filled(np.nan)

        med = np.nanmedian(data.reshape(len(band_ids), -1), axis=1)

    return med

# ============================================================
# 3. Extract one city-year seasonal trajectories
# ============================================================

def extract_city_year_fast_current(city, year):
    out = {}

    # --------------------------------------------------------
    # 8-day dynamic/static-as-stack variables
    # Keep old style: each becomes length-46 trajectory
    # --------------------------------------------------------
    for var in ["EVI", "LAI", "LST", "DEM"]:
        p = p_city_var_year(city, var, year)

        if not os.path.exists(p):
            continue

        try:
            med = read_allbands_coarse_median(
                p,
                factor=COARSE_FACTOR,
                resampling=Resampling.average
            )

            y = np.full(T8, np.nan, dtype=np.float32)
            n = min(T8, len(med))
            y[:n] = med[:n]

            out[var] = y

        except Exception as e:
            print(f"[WARN] failed {city} {year} {var}: {e}")

    # --------------------------------------------------------
    # LC: add for current model MODIS.LC
    # Convert annual/static LC to a repeated length-46 trajectory
    # --------------------------------------------------------
    p = p_city_var_year(city, "LC", year)

    if os.path.exists(p):
        try:
            with rasterio.open(p) as ds:
                if ds.count >= 10:
                    band_id = int(year) - 2013 + 1
                    band_id = max(1, min(ds.count, band_id))
                else:
                    band_id = 1

            lc_med = read_allbands_coarse_median(
                p,
                factor=COARSE_FACTOR,
                resampling=Resampling.nearest,
                band_ids=[band_id]
            )[0]

            out["LC"] = np.full(T8, lc_med, dtype=np.float32)

        except Exception as e:
            print(f"[WARN] failed {city} {year} LC: {e}")

    # --------------------------------------------------------
    # ERA5Lmain: unpack 8 variables per 8-day step
    # --------------------------------------------------------
    p = p_city_var_year(city, "ERA5LMAIN", year)

    if os.path.exists(p):
        try:
            med = read_allbands_coarse_median(
                p,
                factor=COARSE_FACTOR,
                resampling=Resampling.average
            )

            band_count = len(med)
            nstep = band_count // 8

            for j, var in enumerate(ERA5_SUBVARS):
                y = np.full(T8, np.nan, dtype=np.float32)

                for s in range(min(nstep, T8)):
                    idx = s * 8 + j
                    if idx < band_count:
                        y[s] = med[idx]

                out[f"ERA5_{var}"] = y

        except Exception as e:
            print(f"[WARN] failed {city} {year} ERA5LMAIN: {e}")

    # --------------------------------------------------------
    # NTL: monthly 12-band to 46-step interpolation
    # --------------------------------------------------------
    if USE_NTL:
        p = p_city_var_year(city, "NTL", year)

        if os.path.exists(p):
            try:
                with rasterio.open(p) as ds:
                    band_count = min(ds.count, 12)

                med = read_allbands_coarse_median(
                    p,
                    factor=COARSE_FACTOR,
                    resampling=Resampling.average,
                    band_ids=list(range(1, band_count + 1))
                )

                if np.isfinite(med).sum() >= 6:
                    out["NTL"] = monthly12_to_46(med).astype(np.float32)

            except Exception as e:
                print(f"[WARN] failed {city} {year} NTL: {e}")

    return out

