def plot_typical_group(clim="A", vars_to_plot=None):
    if vars_to_plot is None:
        vars_to_plot = [
            "EVI", "LAI", "LST",
            "ERA5_SSRD", "ERA5_VPD", "ERA5_TP",
            "LC", "DEM", "NTL"
        ]

    sub0 = df_typ[df_typ["clim_major"] == clim]

    if sub0.empty:
        print(f"No data for clim={clim}")
        return

    fig, axes = plt.subplots(3, 3, figsize=(13, 9), sharex=True)
    axes = axes.ravel()

    k = 0
    for var in vars_to_plot:
        sub = sub0[sub0["var"] == var].sort_values("step")

        if sub.empty:
            continue

        ax = axes[k]
        x = sub["step"].values

        ax.plot(x, sub["mean"].values, linewidth=1.8)
        ax.fill_between(x, sub["p10"].values, sub["p90"].values, alpha=0.20)
        ax.set_title(f"{clim} - {var}")
        ax.grid(True, alpha=0.3)

        k += 1
        if k >= len(axes):
            break

    for j in range(k, len(axes)):
        axes[j].axis("off")

    fig.suptitle(f"Typical seasonal trajectories: climate group {clim}", y=1.02)
    plt.tight_layout()
    plt.show()

for clim in sorted(df_typ["clim_major"].unique()):
    if clim != "UNK":
        plot_typical_group(clim)
        break

