def build_typical_csv_current():
    all_cities = list_cities(ROOT)
    rng.shuffle(all_cities)

    by_clim = {}
    for c in all_cities:
        by_clim.setdefault(clim_of_city(c), []).append(c)

    picked = []
    for clim, lst in by_clim.items():
        picked += lst[:min(len(lst), MAX_CITIES_PER_CLIM)]

    picked = picked[:MAX_CITIES_TOTAL]

    print("Picked cities total:", len(picked))
    print("Picked by clim:", {
        k: sum(1 for c in picked if clim_of_city(c) == k)
        for k in sorted(by_clim.keys())
    })

    rows = []
    t0 = time.time()

    for city in tqdm(picked, desc="Build typical current model"):
        cdir = os.path.join(ROOT, city)
        years = find_years_in_city(cdir)

        if not years:
            continue

        years_use = pick_years(years, MAX_YEARS_PER_CITY)

        for y in years_use:
            series = extract_city_year_fast_current(city, y)
            clim = clim_of_city(city)

            for var, vec in series.items():
                if np.isfinite(vec).sum() < 5:
                    continue

                rows.append({
                    "city": city,
                    "clim_major": clim,
                    "year": int(y),
                    "var": var,
                    "y": vec
                })

    print("Extraction time (s):", time.time() - t0)

    df = pd.DataFrame(rows)

    if df.empty:
        raise RuntimeError("No series extracted. Check ROOT / filenames / city names.")

    typ = []

    for (clim, var), g in df.groupby(["clim_major", "var"]):
        Y = np.vstack(g["y"].values)
        mean, p05, p10, p90, p95, std = robust_summary(Y)

        for s in range(T8):
            typ.append({
                "clim_major": clim,
                "var": var,
                "step": s,
                "mean": float(mean[s]),
                "p05": float(p05[s]),
                "p10": float(p10[s]),
                "p90": float(p90[s]),
                "p95": float(p95[s]),
                "std": float(std[s]),
                "n_series": int(Y.shape[0]),
                "n_city": int(g["city"].nunique()),
            })

    df_typ = pd.DataFrame(typ).sort_values(
        ["clim_major", "var", "step"]
    ).reset_index(drop=True)

    df_typ.to_csv(TYPICAL_CSV, index=False)

    print("Saved typical CSV:", TYPICAL_CSV)
    print(df_typ.head(20).to_string(index=False))

    return df_typ

