# Keep old-style fast extraction settings
MAX_CITIES_TOTAL    = 100
MAX_CITIES_PER_CLIM = 20
MAX_YEARS_PER_CITY  = 1
COARSE_FACTOR       = 10
USE_NTL             = True

T8 = 46

ERA5_SUBVARS = [
    "T2M", "TD", "VPD", "WIND10M",
    "SSRD", "TP", "SWVL1", "STL1"
]

year_re = re.compile(r".*_(\d{4})\.tif$", re.IGNORECASE)

os.environ["GDAL_NUM_THREADS"] = "ALL_CPUS"
os.environ["GDAL_CACHEMAX"] = "1024"

