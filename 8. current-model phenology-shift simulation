for city in tqdm(picked, desc="Build typical_timeseries_fast"):
    cdir = os.path.join(ROOT, city)
    years = find_years_in_city(cdir)

    if not years:
        continue

    years_use = pick_years(years, MAX_YEARS_PER_CITY)

    for year in years_use:
        series = extract_city_year_fast_current(city, year)
        clim = clim_of_city(city)

        for var, vec in series.items():
            if np.isfinite(vec).sum() < 5:
                continue

            rows.append({
                "city": city,
                "clim_major": clim,
                "year": int(year),
                "var": var,
                "y": vec
            })

print("\nExtraction time (s):", round(time.time() - t0, 1))

df_series = pd.DataFrame(rows)

if df_series.empty:
