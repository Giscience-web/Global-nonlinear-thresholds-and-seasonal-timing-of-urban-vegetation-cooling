def koppen_to_major(k):
    if not isinstance(k, str) or len(k) == 0:
        return "UNK"
    return k[0].upper()

tmp = koppen_df.copy()
tmp["clim_major"] = tmp["koppen"].apply(koppen_to_major)
city2clim = dict(zip(tmp["city_key"].astype(str), tmp["clim_major"].astype(str)))

