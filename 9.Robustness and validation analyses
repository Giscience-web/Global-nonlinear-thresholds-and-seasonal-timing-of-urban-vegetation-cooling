def pearson(a, b):
    a = a.astype(np.float64)
    b = b.astype(np.float64)

    m = np.isfinite(a) & np.isfinite(b)
    a = a[m]
    b = b[m]

    if len(a) < 3:
        return np.nan

    a = a - a.mean()
    b = b - b.mean()

    denom = np.sqrt((a * a).sum() * (b * b).sum()) + 1e-12
    return float((a * b).sum() / denom)

def spearman(a, b):
    a = np.asarray(a)
    b = np.asarray(b)

    m = np.isfinite(a) & np.isfinite(b)
    a = a[m]
    b = b[m]

    if len(a) < 3:
        return np.nan

    ra = a.argsort().argsort().astype(np.float64)
    rb = b.argsort().argsort().astype(np.float64)

    return pearson(ra, rb)

def fit_catboost(Xtr, ytr, Xva, yva, feat_names):
    train_pool = Pool(Xtr, ytr, feature_names=feat_names)
    val_pool = Pool(Xva, yva, feature_names=feat_names)

    try:
        model = CatBoostRegressor(**CB_PARAMS_GPU)
        model.fit(train_pool, eval_set=val_pool, use_best_model=True)
        used_gpu = True
    except Exception as e:
        print("[WARN] GPU failed, CPU fallback:", repr(e))
        model = CatBoostRegressor(**CB_PARAMS_CPU)
        model.fit(train_pool, eval_set=val_pool, use_best_model=True)
        used_gpu = False

    return model, used_gpu

def ridge_fit_residual(X_other, x_target, alpha=1.0):
    """
    Fit ridge:
        x_target ≈ X_other @ w + b
    Return:
        residuals and fitted values.

    This keeps the original conditional-residual permutation idea.
    """
    Xo = X_other.astype(np.float64)
    xt = x_target.astype(np.float64)

    # Safety for rare non-finite values
    if not np.isfinite(Xo).all():
        col_med = np.nanmedian(Xo, axis=0)
        inds = np.where(~np.isfinite(Xo))
        Xo[inds] = np.take(col_med, inds[1])

    if not np.isfinite(xt).all():
        med = np.nanmedian(xt)
        xt[~np.isfinite(xt)] = med

    ones = np.ones((Xo.shape[0], 1), dtype=np.float64)
    A = np.hstack([Xo, ones])

    p = A.shape[1]
    I = np.eye(p, dtype=np.float64)
    I[-1, -1] = 0.0  # do not penalize intercept

    ATA = A.T @ A
    rhs = A.T @ xt

    w = np.linalg.solve(ATA + alpha * I, rhs)

    xhat = A @ w
    resid = xt - xhat

    return resid.astype(np.float32), xhat.astype(np.float32)

