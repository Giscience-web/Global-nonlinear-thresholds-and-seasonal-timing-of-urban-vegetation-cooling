# ============================================================
# 5. Summarize by clim_major × variable × step
# ============================================================

typ = []

for (clim, var), g in df_series.groupby(["clim_major", "var"]):
    Y = np.vstack(g["y"].values)

    mean, p10, p90 = robust_summary(Y)

    for s in range(T8):
        typ.append({
            "clim_major": clim,
            "var": var,
            "step": int(s),
            "mean": float(mean[s]),
            "p10": float(p10[s]),
            "p90": float(p90[s]),
            "n_series": int(Y.shape[0]),
            "n_city": int(g["city"].nunique())
        })

df_typ = (
    pd.DataFrame(typ)
    .sort_values(["clim_major", "var", "step"])
    .reset_index(drop=True)
)

df_typ.to_csv(OUT_TSER, index=False)

