def build_lib_from_typical(df_typ):
    if _infer_cols(df_typ) != "long":
        raise RuntimeError("typical CSV must be long form: clim_major, var, step, mean...")

    cols = {c.lower(): c for c in df_typ.columns}

    clim_col = cols.get("clim_major", "clim_major")
    var_col  = cols.get("var", "var")
    step_col = cols.get("step", "step")

    mu_col = None
    for cand in ["mean", "mu", "p50", "median"]:
        if cand in cols:
            mu_col = cols[cand]
            break

    if mu_col is None:
        raise RuntimeError("typical CSV missing mean/mu/p50/median column.")

    sg_col = None
    for cand in ["sigma_robust", "sigma", "std"]:
        if cand in cols:
            sg_col = cols[cand]
            break

    p05_col = cols.get("p05", None)
    p95_col = cols.get("p95", None)
    p10_col = cols.get("p10", None)
    p90_col = cols.get("p90", None)

    lib = {}
    ncity_by_clim = {}

    for clim, g in df_typ.groupby(df_typ[clim_col]):
        lib[clim] = {}

        if "n_city" in g.columns:
            ncity_by_clim[clim] = int(np.nanmax(g["n_city"].values))
        elif "city" in g.columns:
            ncity_by_clim[clim] = int(g["city"].nunique())
        else:
            ncity_by_clim[clim] = 1

        for var, gg in g.groupby(g[var_col]):
            v = str(var)
            model_ch = MAP_TYPICAL_TO_MODEL.get(v, v)

            if model_ch not in feat2idx:
                continue

            gg = gg.sort_values(step_col)

            mu = _resample_to_T(gg[mu_col].values, T)

            if sg_col is not None:
                sg = _resample_to_T(gg[sg_col].values, T)
            elif (p10_col is not None) and (p90_col is not None):
                p10 = _resample_to_T(gg[p10_col].values, T)
                p90 = _resample_to_T(gg[p90_col].values, T)
                sg = (p90 - p10) / 2.563
            else:
                sg = np.full(T, 0.05)

            if (p05_col is not None) and (p95_col is not None):
                plo = _resample_to_T(gg[p05_col].values, T)
                phi = _resample_to_T(gg[p95_col].values, T)
            elif (p10_col is not None) and (p90_col is not None):
                plo = _resample_to_T(gg[p10_col].values, T)
                phi = _resample_to_T(gg[p90_col].values, T)
            else:
                plo = mu - sg
                phi = mu + sg

            lib[clim][model_ch] = dict(
                mu=mu,
                sigma=np.maximum(sg, 0),
                plo=plo,
                phi=phi
            )

    return lib, ncity_by_clim

